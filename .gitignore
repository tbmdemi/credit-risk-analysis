# =============================================================================
# .gitignore - UCI Credit Card Default Prediction Project
# =============================================================================

# ==================== IDE & Editor Configuration ====================
# VS Code
.vscode/
*.code-workspace
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/extensions.json

# PyCharm / JetBrains
.idea/
*.iml
*.iws
*.ipr
*.iws
.gradle/
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
*~
.swp
.swo

# Emacs
*~
\#*\#
.\#*

# =============================================================================
# ==================== Jupyter & IPython ====================
# =============================================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints
.jupyter/
.ipython/

# =============================================================================
# ==================== Python ====================
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.anaconda/

# PyCharm
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Poetry
poetry.lock

# pipenv
Pipfile.lock

# =============================================================================
# ==================== Data Files ====================
# =============================================================================

# Processed data (comment out if you want to track these)
data/processed/*.csv
data/processed/*.parquet
data/processed/*.pkl
data/processed/*.joblib

# Optional: Ignore raw data too (uncomment if needed)
# data/raw/*.csv
# data/raw/*.xlsx
# data/raw/*.xls

# Temporary data files
*.tmp
*.temp
data/tmp/
data/temp/

# =============================================================================
# ==================== Model Files ====================
# =============================================================================

# Trained models (large files - optional to ignore)
# models/*.pkl
# models/*.joblib
# models/*.h5
# models/*.pt
# models/*.pth

# Model checkpoints
models/checkpoints/
models/logs/

# =============================================================================
# ==================== Visualization & Output Files ====================
# =============================================================================

# Generated visualizations (ignored - generated by notebooks)
Visualization/
Visualization/**/*.png
Visualization/**/*.jpg
Visualization/**/*.pdf

# Temporary plot files
*.tmp.png
*.tmp.jpg

# =============================================================================
# ==================== Logs ====================
# =============================================================================

# Logging
*.log
*.logs
logs/
log/

# Jupyter Notebook logs
.nbstripout
jupyter.log

# Scikit-learn
sklearn_cache/

# =============================================================================
# ==================== Operating System Files ====================
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.Trash-*/
*~

# =============================================================================
# ==================== Miscellaneous ====================
# =============================================================================

# Runtime data
*.pickle
*.pkl
*.pyc
*.pyo

# Secrets and credentials
.env.local
.env.*.local
secrets.json
credentials.json
.aws/
.ssh/

# Local configuration
local_config.py
config.local.py

# Temporary files
*.tmp
*.bak
*.swp
.~*

# Database
*.db
*.sqlite
*.sqlite3

# Compiled files
*.o
*.a
*.lib
*.so
*.dylib

# Static files (if any)
static/
staticfiles/
media/

# =============================================================================
# ==================== Project Specific ====================
# =============================================================================

# Debug and test outputs
debug/
test_output/
*_debug.py
*_test.py

# Exported notebooks (optional)
*.html

# Parameterized notebook outputs
*_output/

# Conda environment files
environment.lock.yml

# =============================================================================
# ==================== Optional: Uncomment if needed ====================
# =============================================================================

# Keep all data files tracked
# !data/
# !data/**
# !data/raw/
# !data/processed/

# Keep models tracked (if not too large)
# !models/
# !models/*.pkl
# !models/*.joblib

# Keep visualizations tracked
# !Visualization/
# !Visualization/**/*.png
